PORT=3210
HOST=127.0.0.1
APP_ORIGIN=http://localhost:3210
# Fill after creating a Meta app with Instagram Login.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_API_VERSION=v27.0
# HTTPS internet origin needed for OAuth and Meta fetching media.
PUBLIC_BASE_URL=
# Real publishing stays OFF until explicitly enabled in Settings by the owner.
# App generates an encryption key in data/.encryption-key on first run.
# Optional: enter the AI key through Pengaturan AI as the owner.
# Never commit a real key. API access/credits are required for vision and AI backgrounds.
OPENAI_API_KEY=
# Optional: Gemini writes all text (auto title/caption in Buat posting, Asisten caption). Usually set in Pengaturan AI.
GEMINI_API_KEY=

# Production uses deploy/production.env and compose.production.yml.
# DATA_DIR=/absolute/persistent/data
# REQUIRE_EXISTING_OWNER=true

# Local Next.js production preview: npm run start:local
# App Router development: npm run dev
